{
  "schemaVersion": 1,
  "id": "bento-modern",
  "version": "1.0.0",
  "kind": "style",
  "name": "Bento Modern",
  "description": "Bento Modern typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Arial, Helvetica, sans-serif",
  "bodyFont": "Arial, Helvetica, sans-serif",
  "headingWeight": 700,
  "bodyWeight": 400,
  "headingScale": 1.05,
  "density": 1,
  "maxWidth": 1320,
  "spacing": 20,
  "borderWidth": 0,
  "borderStyle": "solid",
  "radius": 24,
  "surface": "raised",
  "shadow": "0 4px 16px #00000008",
  "decoration": "none",
  "button": "solid",
  "input": "boxed",
  "background": "plain",
  "defaultMotionId": "spring-interactive",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
}
