{
  "name": "ui-factory-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform android --platform ios --output-dir dist-native"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "57.0.27",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "typescript": "6.0.3"
  }
}
