{
  "schemaVersion": 1,
  "id": "editorial-magazine",
  "version": "1.0.0",
  "kind": "style",
  "name": "Editorial Magazine",
  "description": "Editorial Magazine typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Georgia, serif",
  "bodyFont": "Georgia, serif",
  "headingWeight": 700,
  "bodyWeight": 400,
  "headingScale": 1.22,
  "density": 1.15,
  "maxWidth": 1320,
  "spacing": 28,
  "borderWidth": 1,
  "borderStyle": "solid",
  "radius": 0,
  "surface": "flat",
  "shadow": "none",
  "decoration": "lines",
  "button": "outline",
  "input": "underline",
  "background": "plain",
  "defaultMotionId": "editorial",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
