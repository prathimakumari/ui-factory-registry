{
  "schemaVersion": 1,
  "id": "futuristic-spatial",
  "version": "1.0.0",
  "kind": "style",
  "name": "Futuristic Spatial",
  "description": "Futuristic Spatial typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Arial, Helvetica, sans-serif",
  "bodyFont": "Arial, Helvetica, sans-serif",
  "headingWeight": 450,
  "bodyWeight": 400,
  "headingScale": 1.18,
  "density": 1.35,
  "maxWidth": 1440,
  "spacing": 32,
  "borderWidth": 1,
  "borderStyle": "solid",
  "radius": 32,
  "surface": "glass",
  "shadow": "0 24px 64px #00000015",
  "decoration": "glow",
  "button": "pill",
  "input": "inset",
  "background": "gradient",
  "defaultMotionId": "parallax-light",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
}
