{
  "schemaVersion": 1,
  "id": "retro-arcade",
  "version": "1.0.0",
  "kind": "style",
  "name": "Retro Arcade",
  "description": "Retro Arcade typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "ui-monospace, monospace",
  "bodyFont": "ui-monospace, monospace",
  "headingWeight": 800,
  "bodyWeight": 400,
  "headingScale": 0.93,
  "density": 0.95,
  "maxWidth": 1100,
  "spacing": 20,
  "borderWidth": 4,
  "borderStyle": "double",
  "radius": 0,
  "surface": "outlined",
  "shadow": "4px 4px 0 var(--primary)",
  "decoration": "dots",
  "button": "offset",
  "input": "boxed",
  "background": "grid",
  "defaultMotionId": "energetic",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
}
