{
  "schemaVersion": 1,
  "id": "modern-minimal",
  "version": "1.0.0",
  "kind": "style",
  "name": "Modern Minimal",
  "description": "Modern Minimal typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Arial, Helvetica, sans-serif",
  "bodyFont": "Arial, Helvetica, sans-serif",
  "headingWeight": 650,
  "bodyWeight": 400,
  "headingScale": 1,
  "density": 1,
  "maxWidth": 1180,
  "spacing": 24,
  "borderWidth": 1,
  "borderStyle": "solid",
  "radius": 12,
  "surface": "flat",
  "shadow": "none",
  "decoration": "none",
  "button": "solid",
  "input": "boxed",
  "background": "plain",
  "defaultMotionId": "subtle",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
}
