{
  "schemaVersion": 1,
  "id": "neo-brutalism",
  "version": "1.0.0",
  "kind": "style",
  "name": "Neo Brutalism",
  "description": "Neo Brutalism typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "ui-monospace, monospace",
  "bodyFont": "Arial, Helvetica, sans-serif",
  "headingWeight": 900,
  "bodyWeight": 400,
  "headingScale": 1.08,
  "density": 1,
  "maxWidth": 1280,
  "spacing": 24,
  "borderWidth": 3,
  "borderStyle": "solid",
  "radius": 0,
  "surface": "outlined",
  "shadow": "6px 6px 0 var(--foreground)",
  "decoration": "grid",
  "button": "offset",
  "input": "boxed",
  "background": "plain",
  "defaultMotionId": "spring-interactive",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
}
