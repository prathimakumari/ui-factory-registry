{
  "schemaVersion": 1,
  "id": "organic-natural",
  "version": "1.0.0",
  "kind": "style",
  "name": "Organic Natural",
  "description": "Organic Natural typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Georgia, serif",
  "bodyFont": "Arial, Helvetica, sans-serif",
  "headingWeight": 500,
  "bodyWeight": 400,
  "headingScale": 1.08,
  "density": 1.3,
  "maxWidth": 1100,
  "spacing": 32,
  "borderWidth": 1,
  "borderStyle": "solid",
  "radius": 32,
  "surface": "flat",
  "shadow": "none",
  "decoration": "none",
  "button": "pill",
  "input": "underline",
  "background": "plain",
  "defaultMotionId": "fade-reveal",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
}
