{
  "schemaVersion": 1,
  "id": "corporate-enterprise",
  "version": "1.0.0",
  "kind": "style",
  "name": "Corporate Enterprise",
  "description": "Corporate Enterprise typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Arial, Helvetica, sans-serif",
  "bodyFont": "Arial, Helvetica, sans-serif",
  "headingWeight": 700,
  "bodyWeight": 400,
  "headingScale": 0.94,
  "density": 0.88,
  "maxWidth": 1280,
  "spacing": 20,
  "borderWidth": 1,
  "borderStyle": "solid",
  "radius": 6,
  "surface": "outlined",
  "shadow": "0 2px 8px #00000008",
  "decoration": "lines",
  "button": "solid",
  "input": "boxed",
  "background": "plain",
  "defaultMotionId": "dashboard-fast",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
