  "headingWeight": 750,
  "bodyWeight": 400,
  "headingScale": 1.15,
  "density": 1.1,
  "maxWidth": 1280,
  "spacing": 28,
  "borderWidth": 1,
  "borderStyle": "solid",
  "radius": 18,
  "surface": "raised",
