{
  "schemaVersion": 1,
  "id": "warm-human",
  "version": "1.0.0",
  "kind": "style",
  "name": "Warm Human",
  "description": "Warm Human typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Georgia, serif",
  "bodyFont": "Arial, Helvetica, sans-serif",
  "headingWeight": 550,
  "bodyWeight": 400,
  "headingScale": 1.12,
  "density": 1.2,
  "maxWidth": 1120,
  "spacing": 28,
  "borderWidth": 1,
  "borderStyle": "solid",
  "radius": 16,
  "surface": "flat",
  "shadow": "0 4px 16px #00000008",
  "decoration": "none",
