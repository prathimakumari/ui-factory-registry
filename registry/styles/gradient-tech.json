{
  "schemaVersion": 1,
  "id": "gradient-tech",
  "version": "1.0.0",
  "kind": "style",
  "name": "Gradient Tech",
  "description": "Gradient Tech typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Arial, Helvetica, sans-serif",
