{
  "schemaVersion": 1,
  "id": "industrial",
  "version": "1.0.0",
  "kind": "style",
  "name": "Industrial",
  "description": "Industrial typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "ui-monospace, monospace",
  "bodyFont": "Arial, Helvetica, sans-serif",
  "headingWeight": 800,
