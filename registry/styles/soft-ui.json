{
  "schemaVersion": 1,
  "id": "soft-ui",
  "version": "1.0.0",
  "kind": "style",
  "name": "Soft Ui",
  "description": "Soft Ui typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Arial, Helvetica, sans-serif",
  "bodyFont": "Arial, Helvetica, sans-serif",
  "headingWeight": 600,
  "bodyWeight": 400,
  "headingScale": 0.98,
  "density": 1.1,
  "maxWidth": 1160,
  "spacing": 28,
  "borderWidth": 0,
  "borderStyle": "solid",
  "radius": 24,
  "surface": "inset",
  "shadow": "8px 8px 24px #00000014",
  "decoration": "none",
  "button": "pill",
  "input": "inset",
  "background": "plain",
  "defaultMotionId": "premium-smooth",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
}
