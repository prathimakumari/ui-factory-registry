{
  "schemaVersion": 1,
  "id": "glassmorphism",
  "version": "1.0.0",
  "kind": "style",
  "name": "Glassmorphism",
  "description": "Glassmorphism typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Arial, Helvetica, sans-serif",
