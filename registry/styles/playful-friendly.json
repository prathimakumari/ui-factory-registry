{
  "schemaVersion": 1,
  "id": "playful-friendly",
  "version": "1.0.0",
  "kind": "style",
  "name": "Playful Friendly",
  "description": "Playful Friendly typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Arial, Helvetica, sans-serif",
  "bodyFont": "Arial, Helvetica, sans-serif",
  "headingWeight": 850,
  "bodyWeight": 400,
  "headingScale": 1.15,
  "density": 1.15,
  "maxWidth": 1160,
  "spacing": 28,
  "borderWidth": 2,
  "borderStyle": "solid",
  "radius": 28,
  "surface": "raised",
  "shadow": "0 8px 0 color-mix(in srgb,var(--primary) 20%,transparent)",
  "decoration": "dots",
  "button": "pill",
  "input": "boxed",
  "background": "plain",
  "defaultMotionId": "playful",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
}
