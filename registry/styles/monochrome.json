{
  "schemaVersion": 1,
  "id": "monochrome",
  "version": "1.0.0",
  "kind": "style",
  "name": "Monochrome",
  "description": "Monochrome typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Arial, Helvetica, sans-serif",
  "bodyFont": "ui-monospace, monospace",
  "headingWeight": 700,
  "bodyWeight": 400,
  "headingScale": 1,
  "density": 0.95,
  "maxWidth": 1180,
  "spacing": 24,
  "borderWidth": 1,
  "borderStyle": "solid",
  "radius": 2,
  "surface": "outlined",
  "shadow": "none",
  "decoration": "none",
  "button": "outline",
  "input": "underline",
  "background": "plain",
  "defaultMotionId": "no-motion",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
}
