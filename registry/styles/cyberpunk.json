{
  "schemaVersion": 1,
  "id": "cyberpunk",
  "version": "1.0.0",
  "kind": "style",
  "name": "Cyberpunk",
  "description": "Cyberpunk typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "ui-monospace, monospace",
  "bodyFont": "ui-monospace, monospace",
  "headingWeight": 800,
  "bodyWeight": 400,
  "headingScale": 1.1,
  "density": 0.9,
  "maxWidth": 1360,
  "spacing": 20,
  "borderWidth": 2,
  "borderStyle": "solid",
  "radius": 2,
  "surface": "outlined",
  "shadow": "0 0 16px color-mix(in srgb,var(--primary) 18%,transparent)",
  "decoration": "grid",
  "button": "offset",
  "input": "boxed",
  "background": "grid",
  "defaultMotionId": "futuristic",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
}
