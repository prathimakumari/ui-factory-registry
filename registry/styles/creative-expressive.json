{
  "schemaVersion": 1,
  "id": "creative-expressive",
  "version": "1.0.0",
  "kind": "style",
  "name": "Creative Expressive",
  "description": "Creative Expressive typography, density, surface and interaction treatments.",
  "tags": ["style"],
  "files": ["lib/theme.ts"],
  "dependencies": ["react", "zod"],
  "headingFont": "Georgia, serif",
  "bodyFont": "Arial, Helvetica, sans-serif",
  "headingWeight": 850,
  "bodyWeight": 400,
  "headingScale": 1.4,
  "density": 1.25,
  "maxWidth": 1400,
  "spacing": 32,
  "borderWidth": 2,
  "borderStyle": "solid",
  "radius": 8,
  "surface": "raised",
  "shadow": "8px 8px 0 var(--accent)",
  "decoration": "dots",
  "button": "offset",
  "input": "boxed",
  "background": "plain",
  "defaultMotionId": "energetic",
  "suitableCategories": ["marketing", "content-commerce", "industry", "dashboard", "specialized"],
  "accessibility": "Preserve focus rings, text contrast, 44px touch targets and readable body text. Decorative effects are nonessential."
}
